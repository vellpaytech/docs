---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const apiActive = /\/(indonesia|vietnam|korea|cambodia|india|colombia|argentina|brazil)\//.test(Astro.url.pathname);
---
<div class="vp-header"><div class="brand"><SiteTitle {...Astro.props} /></div><nav class="top-links" aria-label="主导航"><a class:list={{ active: !apiActive }} href={`${base}/zh/guides/quick-start/`}>开发指南</a><a class:list={{ active: apiActive }} href={`${base}/zh/indonesia/payin/create/`}>API 文档</a></nav><div class="search"><Search {...Astro.props} /></div><div class="utilities"><ThemeSelect {...Astro.props} /><LanguageSelect {...Astro.props} /></div></div>
<style>.vp-header{align-items:center;display:flex;gap:1.3rem;height:100%}.brand{flex:0 0 auto}.top-links{align-items:center;display:flex;gap:.25rem}.top-links a{border-radius:6px;color:var(--sl-color-gray-2);font-size:.84rem;font-weight:650;padding:.48rem .65rem;text-decoration:none}.top-links a:hover,.top-links a.active{color:var(--color-primary)}.top-links a.active{background:var(--color-selected)}.search{flex:1 1 28rem;max-width:34rem}.utilities{align-items:center;display:flex;gap:.35rem;margin-left:auto}@media(max-width:50rem){.top-links{display:none}.search{max-width:none}.utilities{display:none}}</style>
